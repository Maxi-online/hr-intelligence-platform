# Include any files or directories that you don't want to be copied to your
# container here (e.g., local build artifacts, temporary files, etc.).
#
# For more help, visit the .dockerignore file reference guide at
# https://docs.docker.com/engine/reference/builder/#dockerignore-file

**/.DS_Store
**/__pycache__
**/.venv
**/.classpath
**/.dockerignore
**/.env
**/.git
**/.gitignore
**/.project
**/.settings
**/.toolstarget
**/.vs
**/.vscode
**/*.*proj.user
**/*.dbmdl
**/*.jfm
**/bin
**/charts
**/docker-compose*
**/compose*
**/Dockerfile*
**/node_modules
**/npm-debug.log
**/obj
**/secrets.dev.yaml
**/values.dev.yaml
LICENSE
README.md
# ====================================
# AI Supervisor - Docker Ignore
# ====================================

# ===============================
# FLYLE DEVELOPING
# ===============================
.git/
.gitignore
*.md
LICENSE
CHANGELOG*
docs/
.vscode/
.idea/

# ===============================
# CONFIDENTIAL DATA
# ===============================
# Don't copy secret files into image.
settings.json
.env
.env.*
*.key
*.pem
*.p12
*.pfx

# But let's leave examples.
!settings.example.json
!.env.example

# ===============================
# Temporarily and Systemally FLYLS
# ===============================
# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual environment
supevisor_env/
supervisor_env/
.venv/
venv/
env/

# Logging
*.log
logs/
log/

# Temporary files
*.tmp
*.temp
temp/
tmp/
.cache/

# Databases
*.db
*.sqlite
*.sqlite3

# ===============================
# OPERATIONAL SYSTEMS
# ===============================
# Windows
Thumbs.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Linux
*~
.directory
.Trash-*

# ===============================
# DOCKER SPECIFIC
# ===============================
# Docker files (other than main files)
docker-compose.override.yml
docker-compose.*.yml
!docker-compose.yml

# Volumes and Bind mounts
data/
volume/
mounts/

# ===============================
# IDE AND EDITORS
# ===============================
.vscode/
.idea/
*.swp
*.swo
*~

# ===============================
# STEERING
# ===============================
.coverage
.pytest_cache/
htmlcov/
.tox/
test_results/

# ===============================
# SPECIFIC FOR THE PROJECT
# ===============================
# Memory and Cash
memory_storage/
chat_history/
simple_memory.db

# Exports and reports
exports/
reports/
*.xlsx
*.csv

# Monitoring
monitoring/
metrics/

# Backup
*.bak
*.backup
backup/

# ===============================
# EXCEPTIONS (which should not be ignored)
# ===============================
# Project configuration files
!requirements.txt
!config.py
!Dockerfile
!docker-compose.yml
!docker/

# Application reference code
!*.py
!microservices/
!README.md
