FROM python:3.11-slim

# Installation of systems relationships
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Installation of the Work Directorate
WORKDIR /app

# Copy Dependence Files
COPY requirements.txt .

# Installation Python Dependency
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY . .

# Creation of a directory for lairs
RUN mkdir -p logs

# Establishment of access rights
RUN chmod +x *.py

# Opening of the port for Streamlit
EXPOSE 8501

# The default command for Streamlit
CMD ["streamlit", "run", "frontend/app.py", "--server.port=8501", "--server.address=0.0.0.0"]