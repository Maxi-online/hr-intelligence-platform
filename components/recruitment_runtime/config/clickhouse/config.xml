<?xml version="1.0"?>
<clickhouse>
    <!-- Основные настройки -->
    <logger>
        <level>information</level>
        <log>/var/log/clickhouse-server/clickhouse-server.log</log>
        <errorlog>/var/log/clickhouse-server/clickhouse-server.err.log</errorlog>
        <size>1000M</size>
        <count>10</count>
    </logger>

    <!-- HTTP интерфейс -->
    <http_port>8123</http_port>
    <tcp_port>9000</tcp_port>
    
    <!-- Межсерверный HTTP порт -->
    <interserver_http_port>9009</interserver_http_port>

    <!-- Настройки для Docker - только IPv4 -->
    <listen_host>0.0.0.0</listen_host>
    
    <!-- Максимальное количество соединений -->
    <max_connections>4096</max_connections>
    
    <!-- Настройки для аналитических запросов -->
    <max_concurrent_queries>100</max_concurrent_queries>
    
    <!-- Настройки памяти -->
    <max_memory_usage>10000000000</max_memory_usage> <!-- 10GB -->
    <max_memory_usage_for_user>5000000000</max_memory_usage_for_user> <!-- 5GB -->
    
    <!-- Настройки компрессии -->
    <compression>
        <case>
            <method>lz4</method>
        </case>
    </compression>

    <!-- Профили пользователей -->
    <profiles>
        <default>
            <max_memory_usage>10000000000</max_memory_usage>
            <use_uncompressed_cache>0</use_uncompressed_cache>
            <load_balancing>random</load_balancing>
        </default>
        
        <hr_analytics>
            <max_memory_usage>20000000000</max_memory_usage>
            <max_bytes_before_external_group_by>20000000000</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>20000000000</max_bytes_before_external_sort>
        </hr_analytics>
        
        <!-- Профиль для AI анализа -->
        <ai_analysis>
            <max_memory_usage>15000000000</max_memory_usage>
            <max_execution_time>300</max_execution_time> <!-- 5 минут -->
        </ai_analysis>
    </profiles>

    <!-- Пользователи -->
    <users>
        <default>
            <password from_env="CLICKHOUSE_PASSWORD"/>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
        </default>
        
        <hrhelp_user>
            <password from_env="CLICKHOUSE_PASSWORD"/>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>hr_analytics</profile>
            <quota>default</quota>
        </hrhelp_user>
    </users>

    <!-- Квоты -->
    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>

    <!-- Настройки MergeTree -->
    <merge_tree>
        <max_suspicious_broken_parts>10</max_suspicious_broken_parts>
    </merge_tree>
    
    <!-- Настройки для распределенных запросов -->
    <distributed_ddl>
        <path>/clickhouse/task_queue/ddl</path>
    </distributed_ddl>

    <!-- Настройки кэша -->
    <mark_cache_size>5368709120</mark_cache_size> <!-- 5GB -->
    <uncompressed_cache_size>8589934592</uncompressed_cache_size> <!-- 8GB -->
    
    <!-- Настройки временных файлов -->
    <tmp_path>/var/lib/clickhouse/tmp/</tmp_path>
    
    <!-- Настройки форматов данных -->
    <format_schema_path>/var/lib/clickhouse/format_schemas/</format_schema_path>
</clickhouse>